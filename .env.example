# Copy this file to .env and fill in the values. NEVER commit .env.

# Postgres connection string (Supabase/Neon: copy from the dashboard)
DATABASE_URL=postgres://user:password@host:5432/dbname
# true for hosted databases (Supabase, Neon, Render), false/blank for local Postgres
DATABASE_SSL=true

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

PORT=4000

# Frontend URL(s), comma-separated. Leave blank during development to allow all.
CORS_ORIGIN=
